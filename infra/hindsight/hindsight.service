[Unit]
Description=Hindsight memory API (lean config)
After=network-online.target

[Service]
User=brain
ExecStart=/home/brain/hindsight/run.sh
# Long-lived Claude token for the claude-code LLM provider (see infra/README.md §2); optional.
EnvironmentFile=-/home/brain/.config/brain/claude.env
Restart=on-failure
RestartSec=10
# The API holds ~1.1 GB of rarely used memory (ONNX weights, freed heap) that sits in swap, and it
# grew to ~1.6 GB over 10 days (2026-11-13). Caps sit above that baseline, so only real runaway
# growth is OOM-killed and restarted instead of filling the host's 2 GB swap.
MemoryHigh=700M
MemoryMax=900M
MemorySwapMax=1500M

[Install]
WantedBy=multi-user.target
