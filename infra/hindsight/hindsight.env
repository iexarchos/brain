# Hindsight lean config for a 1 GB host. Loaded by the systemd unit.
HINDSIGHT_API_HOST=127.0.0.1
HINDSIGHT_API_PORT=8888
HINDSIGHT_API_WORKERS=1
# LLM: Claude Code subscription (no API key)
HINDSIGHT_API_LLM_PROVIDER=claude-code
HINDSIGHT_API_LLM_MODEL=claude-haiku-5-5
HINDSIGHT_API_LLM_MAX_CONCURRENT=2
# Local embeddings via ONNX; no neural reranker
HINDSIGHT_API_EMBEDDINGS_PROVIDER=onnx
HINDSIGHT_API_EMBEDDINGS_ONNX_BATCH_SIZE=8
HINDSIGHT_API_RERANKER_PROVIDER=rrf
# Embedded Postgres (pg0), small pool
HINDSIGHT_API_DB_POOL_MIN_SIZE=1
HINDSIGHT_API_DB_POOL_MAX_SIZE=10
# Concurrency caps: limit memory spikes when several retains/recalls run at once (2026-11-13,
# weekly review #15). Defaults are 4 retains, 32 recalls, parallel Postgres workers on.
HINDSIGHT_API_RETAIN_MAX_CONCURRENT=1
HINDSIGHT_API_RECALL_MAX_CONCURRENT=4
HINDSIGHT_API_EMBEDDINGS_LOCAL_MAX_CONCURRENT=1
HINDSIGHT_API_DB_MAX_PARALLEL_WORKERS_PER_GATHER=0
HINDSIGHT_API_MIGRATION_ISOLATION=true
# glibc malloc: return large freed blocks to the OS instead of keeping them in the heap. Loading
# the ONNX model left ~400 MB of freed heap that ended up in swap (2026-11-13).
MALLOC_ARENA_MAX=2
MALLOC_MMAP_THRESHOLD_=131072
MALLOC_TRIM_THRESHOLD_=131072
