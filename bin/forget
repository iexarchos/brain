#!/usr/bin/env python3
"""forget — remove an agent session from Hindsight memory (its document and all facts from it).

  forget --last          # the most recent Claude Code or Codex session
  forget --list          # recent sessions stored in memory, newest first
  forget <session-id>    # a specific session (id prefix is enough)

Run it after the session has ended: an open session is re-saved each time the agent replies.
Doesn't touch git: if a nightly run already happened, facts may be in a reflect PR and in the
memory-backup branch history.
"""
import glob, json, os, sys, time, urllib.error, urllib.parse, urllib.request

from brainenv import BASE
HOME = os.path.expanduser("~")
WAIT_SECONDS = 1800  # how long to wait for a queued session to be stored


def call(method, url):
    with urllib.request.urlopen(urllib.request.Request(url, method=method), timeout=60) as r:
        return json.loads(r.read() or b"{}")


def sessions():
    """Stored session documents (Claude Code / Codex transcripts), newest first."""
    d = call("GET", f"{BASE}/documents?limit=1000")
    items = d.get("items", d) if isinstance(d, dict) else d
    docs = [x for x in items if x["id"].startswith("conversation:")]
    return sorted(docs, key=lambda x: x.get("created_at") or "", reverse=True)


def pending():
    return call("GET", f"{BASE}/stats").get("pending_operations", 0) > 0


def last_local_session():
    """Id of the most recently modified Claude Code or Codex transcript on disk."""
    files = glob.glob(f"{HOME}/.claude/projects/*/*.jsonl") + \
            glob.glob(f"{HOME}/.codex/sessions/**/*.jsonl", recursive=True)
    if not files:
        return None
    newest = os.path.basename(max(files, key=os.path.getmtime))[:-len(".jsonl")]
    return newest[-36:]  # Codex rollout files end with the session uuid


def delete(doc_id):
    try:
        call("DELETE", f"{BASE}/documents/{urllib.parse.quote(doc_id, safe='')}")
        print(f"forget: removed {doc_id}")
    except urllib.error.HTTPError as e:
        sys.exit(f"forget: could not remove {doc_id}: HTTP {e.code}")


def main():
    if len(sys.argv) != 2 or sys.argv[1] in ("-h", "--help"):
        sys.exit(__doc__)
    arg = sys.argv[1]
    stored = sessions()
    if arg == "--list":
        for x in stored[:20]:
            print(f"{str(x.get('created_at'))[:16]}  {x['id'].split(':', 1)[1]}")
        return
    target = last_local_session() if arg == "--last" else arg
    if not target:
        sys.exit("forget: no local sessions found")
    match = lambda docs: [x["id"] for x in docs if x["id"].split(":", 1)[1].startswith(target)]
    matches = match(stored)
    # A just-ended session may still be queued behind other ingestion; wait for it to land.
    deadline = time.time() + WAIT_SECONDS
    while not matches and pending() and time.time() < deadline:
        print(f"forget: session {target[:8]} not stored yet; Hindsight is still processing, waiting…",
              flush=True)
        time.sleep(15)
        matches = match(sessions())
    if not matches:
        sys.exit(f"forget: session {target} is not in memory (already forgotten, private, or not saved)")
    if len(matches) > 1:
        sys.exit("forget: ambiguous id, matches: " + ", ".join(matches))
    delete(matches[0])


if __name__ == "__main__":
    main()
